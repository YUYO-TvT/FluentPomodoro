<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Windows 11 Fluent 深色主题调色板 ===== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#B8202020" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#323232" />
    <SolidColorBrush x:Key="CardBrush" Color="#F52A2A2A" />
    <SolidColorBrush x:Key="LayerBrush" Color="#802C2C2C" />

    <SolidColorBrush x:Key="StrokeBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#4C4C4C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#33FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#0A0A0A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="PressBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#464646" />

    <SolidColorBrush x:Key="AccentFillBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7BD4FF" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#4FC7FA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1B3242" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#4060CDFF" />

    <SolidColorBrush x:Key="PhaseFocusBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="PhaseShortBrush" Color="#6CCB8F" />
    <SolidColorBrush x:Key="PhaseLongBrush" Color="#B39DFF" />

    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />

    <!-- 背景图片模式下的遮罩（保证文字可读） -->
    <SolidColorBrush x:Key="ImageScrimBrush" Color="#A6101010" />

    <!-- GitHub 式绿点矩阵配色（深色主题下越久越亮/越浓） -->
    <SolidColorBrush x:Key="Heat0Brush" Color="#2D333B" />
    <SolidColorBrush x:Key="Heat1Brush" Color="#0E4429" />
    <SolidColorBrush x:Key="Heat2Brush" Color="#006D32" />
    <SolidColorBrush x:Key="Heat3Brush" Color="#26A641" />
    <SolidColorBrush x:Key="Heat4Brush" Color="#39D353" />
    <SolidColorBrush x:Key="Heat5Brush" Color="#69F0AE" />
</ResourceDictionary>
