<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Windows 11 Fluent 浅色主题调色板 ===== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="AppDisplayFontFamily">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#B8F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="LayerBrush" Color="#80FFFFFF" />

    <SolidColorBrush x:Key="StrokeBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#C9C9C9" />
    <SolidColorBrush x:Key="DividerBrush" Color="#EAEAEA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B8B8B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="HoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="PressBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#18000000" />
    <SolidColorBrush x:Key="TrackBrush" Color="#DFDFDF" />

    <!-- 强调色（启动时若系统可取则被系统强调色覆盖） -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1975C5" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#3183CB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E7F0FA" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#330067C0" />

    <!-- 阶段配色：专注 / 短休息 / 长休息 -->
    <SolidColorBrush x:Key="PhaseFocusBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="PhaseShortBrush" Color="#0F7B3F" />
    <SolidColorBrush x:Key="PhaseLongBrush" Color="#7A5AC4" />

    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#26000000" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />

    <!-- 背景图片模式下的遮罩（保证文字可读） -->
    <SolidColorBrush x:Key="ImageScrimBrush" Color="#99FFFFFF" />

    <!-- GitHub 式绿点矩阵配色（0 = 无记录，越深表示当天专注越久） -->
    <SolidColorBrush x:Key="Heat0Brush" Color="#EBEDF0" />
    <SolidColorBrush x:Key="Heat1Brush" Color="#9BE9A8" />
    <SolidColorBrush x:Key="Heat2Brush" Color="#40C463" />
    <SolidColorBrush x:Key="Heat3Brush" Color="#30A14E" />
    <SolidColorBrush x:Key="Heat4Brush" Color="#216E39" />
    <SolidColorBrush x:Key="Heat5Brush" Color="#0B3B22" />
</ResourceDictionary>
